# Mirrors frontend/.npmrc. `min-release-age` holds back freshly-published
# versions, which is the repo's standing supply-chain guard.
ignore-scripts=true
min-release-age=2
audit=true
fund=false
package-lock=true
prefer-offline=true
strict-ssl=true
save-exact=true

# `build` chains its steps explicitly (`npm run generate && next build &&
# npm run index`) rather than relying on npm's pre/post lifecycle, because
# `ignore-scripts` above disables that lifecycle. A silently skipped step
# would cost the llms.txt files or the Pagefind index with a green build.